{
  "name": "synology-downloadstation-cli",
  "version": "0.2.2",
  "description": "A React-powered OpenTUI client for Synology Download Station",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georgkreimer/synology-downloadstation-cli.git"
  },
  "homepage": "https://github.com/georgkreimer/synology-downloadstation-cli#readme",
  "bugs": {
    "url": "https://github.com/georgkreimer/synology-downloadstation-cli/issues"
  },
  "bin": {
    "synology-ds": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/development.md",
    "docs/release.md",
    "docs/safari-extension.md",
    "extension",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "rm -rf dist && bun build src/index.tsx --outdir dist --target bun --minify --packages external && chmod +x dist/index.js",
    "lint": "bunx tsc --noEmit",
    "prepack": "bun run build",
    "start": "bun run dist/index.js",
    "test": "bun test"
  },
  "packageManager": "bun@1.2.17",
  "dependencies": {
    "@opentui/core": "0.1.97",
    "@opentui/react": "0.1.97",
    "commander": "^12.1.0",
    "react": "^19.2.0",
    "strip-ansi": "^7.1.0",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.3"
  }
}
